# Maintainer: Julian Hermstad <dev@juhlabs.com>

pkgname=juhradial-mx
pkgver=0.4.5beta6
# Tag and archive form of pkgver (pkgver cannot hold a hyphen): 0.4.5beta1 -> 0.4.5-beta.1
_srcver="${pkgver/beta/-beta.}"
pkgrel=1
pkgdesc="Beautiful radial menu for Logitech MX Master mice on Linux"
arch=('x86_64')
url="https://github.com/JuhLabs/juhradial-mx"
license=('GPL-3.0-only')
depends=(
    'gtk4'
    'gtk4-layer-shell'
    'libadwaita'
    'python'
    'python-gobject'
    'python-cairo'
    'python-cryptography'
    'python-pyqt6'
    'qt6-svg'
    'qt6-declarative'
    'dbus'
)
makedepends=('cargo')
optdepends=(
    'ydotool: for cursor capture on Wayland'
    'python-zeroconf: Flow, finding linked computers on the network'
    'python-requests: Flow, talking to linked computers'
)
conflicts=("$pkgname-git")
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$_srcver.tar.gz")
# SKIP only in this in-tree copy: the tag's archive contains this file, so it
# cannot carry its own checksum. The AUR copy has the real sum (updpkgsums).
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$_srcver"
    export RUSTUP_TOOLCHAIN=stable
    # Keep crates/ beside daemon/ for the mx-keypad path dependency.
    cargo fetch --locked --manifest-path daemon/Cargo.toml
    cargo fetch --locked --manifest-path crates/mx-keypad/Cargo.toml
}

build() {
    cd "$pkgname-$_srcver"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --frozen --manifest-path daemon/Cargo.toml
}

check() {
    cd "$pkgname-$_srcver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --manifest-path crates/mx-keypad/Cargo.toml
}

package() {
    cd "$pkgname-$_srcver"

    # Install daemon binary
    install -Dm755 daemon/target/release/juhradiald "$pkgdir/usr/bin/juhradiald"

    # Install launcher scripts
    install -Dm755 scripts/juhradial-mx.sh "$pkgdir/usr/bin/juhradial-mx"
    install -Dm755 scripts/juhradial-settings.sh "$pkgdir/usr/bin/juhradial-settings"

    # Install overlay Python files
    install -dm755 "$pkgdir/usr/share/juhradial"
    install -Dm644 overlay/*.py "$pkgdir/usr/share/juhradial/"

    # Install flow module
    cp -r overlay/flow "$pkgdir/usr/share/juhradial/flow"

    # Install locales
    if [ -d "overlay/locales" ]; then
        cp -r overlay/locales "$pkgdir/usr/share/juhradial/"
    fi

    # Install assets
    install -dm755 "$pkgdir/usr/share/juhradial/assets"
    cp -r assets/* "$pkgdir/usr/share/juhradial/assets/"

    # Qt/QML settings app (tools/ and __pycache__ excluded); the overlay also
    # resolves wheel skins under /usr/share/juhradial/assets/wheels
    install -dm755 "$pkgdir/usr/share/juhradial/settings-qt"
    install -Dm644 settings-qt/main.py "$pkgdir/usr/share/juhradial/settings-qt/main.py"
    install -Dm644 settings-qt/VERSION "$pkgdir/usr/share/juhradial/settings-qt/VERSION"
    cp -r settings-qt/bridge settings-qt/qml settings-qt/assets "$pkgdir/usr/share/juhradial/settings-qt/"
    find "$pkgdir/usr/share/juhradial/settings-qt" -type d -name __pycache__ -exec rm -rf {} +
    cp -r settings-qt/assets/wheels "$pkgdir/usr/share/juhradial/assets/"

    # Install desktop files
    install -Dm644 packaging/juhradial-mx.desktop "$pkgdir/usr/share/applications/juhradial-mx.desktop"
    install -Dm644 packaging/org.kde.juhradialmx.settings.desktop "$pkgdir/usr/share/applications/org.kde.juhradialmx.settings.desktop"

    # Install icon
    install -Dm644 assets/juhradial-mx.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/juhradial-mx.svg"

    # Install systemd user service
    install -Dm644 packaging/systemd/juhradialmx-daemon.service "$pkgdir/usr/lib/systemd/user/juhradialmx-daemon.service"
    # The unit names the curl installer's /usr/local/bin; the package puts the daemon in /usr/bin.
    sed -i 's|^ExecStart=/usr/local/bin/juhradiald|ExecStart=/usr/bin/juhradiald|' "$pkgdir/usr/lib/systemd/user/juhradialmx-daemon.service"

    # Install udev rules
    install -Dm644 packaging/udev/99-juhradialmx.rules "$pkgdir/usr/lib/udev/rules.d/99-juhradialmx.rules"
    install -Dm644 packaging/udev/70-juhradialmx-uaccess.rules "$pkgdir/usr/lib/udev/rules.d/70-juhradialmx-uaccess.rules"
    install -Dm644 packaging/udev/60-ydotool-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-ydotool-uinput.rules"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Install docs
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
}
