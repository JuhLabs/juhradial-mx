msgid "30 minutes"
msgstr "30 minuten"

#: settings-qt/bridge/backend.py:3573
msgid "30 seconds"
msgstr "30 seconden"

#: settings-qt/qml/pages/FlowPage.qml:494
msgid ""
"4. Approve the Mac under Computers when it asks. Nothing is shared before "
"that."
msgstr ""
"4. Geef de Mac toestemming onder Computers wanneer deze erom vraagt. Tot dan "
"wordt niets gedeeld."

