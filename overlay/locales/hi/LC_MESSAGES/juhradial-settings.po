msgid "10 minutes"
msgstr "10 मिनट"

#: settings-qt/bridge/backend.py:3573
msgid "10 seconds"
msgstr "10 सेकंड"

#: settings-qt/assets/keypad/profiles.json
msgid "1st Unread"
msgstr "पहला अपठित"

